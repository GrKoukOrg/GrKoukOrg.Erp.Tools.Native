<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:GrKoukOrg.Erp.Tools.Native.PageModels"
             xmlns:models="clr-namespace:GrKoukOrg.Erp.Tools.Native.Models"
             xmlns:controls="clr-namespace:GrKoukOrg.Erp.Tools.Native.Pages.Controls"
             xmlns:pullToRefresh="clr-namespace:Syncfusion.Maui.Toolkit.PullToRefresh;assembly=Syncfusion.Maui.Toolkit"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:converters="clr-namespace:GrKoukOrg.Erp.Tools.Native.Converters"
             x:Class="GrKoukOrg.Erp.Tools.Native.Pages.MainPage"
             x:DataType="pageModels:MainPageModel"
             x:Name="MyPage"
             Title="{Binding Today}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            EventName="NavigatedTo"
            BindingContext="{Binding Path=BindingContext, Source={x:Reference MyPage}
            ,x:DataType=ContentPage}"
            Command="{Binding NavigatedToCommand}" />
        <toolkit:EventToCommandBehavior
            EventName="NavigatedFrom"
            BindingContext="{Binding Path=BindingContext, Source={x:Reference MyPage}
            ,x:DataType=ContentPage}"
            Command="{Binding NavigatedFromCommand}" />
        <toolkit:EventToCommandBehavior
            EventName="Appearing"
            BindingContext="{Binding Path=BindingContext, Source={x:Reference MyPage}
            ,x:DataType=ContentPage}"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:StringNullOrEmptyToBoolConverter x:Key="StringNullOrEmptyToBoolConverter"/> 
            <converters:BoolStatusConverter x:Key="BoolStatusConverter" />
                                                         
                                                         
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid ColumnSpacing="{StaticResource LayoutSpacing}"
          RowSpacing="{StaticResource LayoutSpacing}"
          Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />


        </Grid.RowDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Text="Τελευταίος Συγχρονισμός" />
        <Label Grid.Row="0" Grid.Column="1" Text="{Binding LastSynced, StringFormat='{0:dd/MM/yyyy}'}" />
        <Button Grid.Row="1" Grid.Column="1" Text="Κλείσιμο Ημέρας" Command="{Binding DateCloseCommand}" />
        <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
               Text="{Binding VersionInfo}"
               HorizontalOptions="Center"
               VerticalOptions="End"
               FontSize="Small"
               TextColor="Gray"
               Margin="0,10,0,5" />
        <VerticalStackLayout Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
            <Label Text="Startup Checks" FontSize="24" />
            <HorizontalStackLayout Spacing="24">
                <!-- Network Check -->
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="Network:" />
                    <BoxView Color="{Binding NetworkConnected, Converter={StaticResource BoolToColorConverter}}"
                             WidthRequest="20" HeightRequest="20" />
                    <Label>
                        <Label.Text>
                            <MultiBinding Converter="{StaticResource BoolStatusConverter}">
                                <Binding Path="NetworkConnected" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </HorizontalStackLayout>
                <!-- Internet Check -->
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="Internet:" />
                    <BoxView Color="{Binding InternetAccessible, Converter={StaticResource BoolToColorConverter}}"
                             WidthRequest="20" HeightRequest="20" />
                    <Label>
                        <Label.Text>
                            <MultiBinding Converter="{StaticResource BoolStatusConverter}">
                                <Binding Path="InternetAccessible" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </HorizontalStackLayout>
                <!-- API Check -->
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="API:" />
                    <BoxView Color="{Binding ApiConnected, Converter={StaticResource BoolToColorConverter}}"
                             WidthRequest="20" HeightRequest="20" />
                    <Label>
                        <Label.Text>
                            <MultiBinding Converter="{StaticResource BoolStatusConverter}">
                                <Binding Path="ApiConnected" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </HorizontalStackLayout>
                <!-- Token Check -->
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="Token:" />
                    <BoxView Color="{Binding TokenRefreshSuccess, Converter={StaticResource BoolToColorConverter}}"
                             WidthRequest="20" HeightRequest="20" />
                    <Label>
                        <Label.Text>
                            <MultiBinding Converter="{StaticResource BoolStatusConverter}">
                                <Binding Path="TokenRefreshSuccess" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </HorizontalStackLayout>
                <Button 
                    Text="Perform Checks"
                    Margin="0,10,0,0"
                    Command="{Binding PerformChecksCommand}" />
            </HorizontalStackLayout>
            

            <Label Text="{Binding ErrorMessage}" TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToBoolConverter}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>